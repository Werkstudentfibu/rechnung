# Vorlage fuer die optionalen Schnittstellen. Ohne diese Datei bleibt das
# Programm rein lokal/offline (siehe SPEC Abschnitt 5).
#
# Nutzung Linux/macOS:   set -a; . ./rechnung.env; set +a; rechnung fetch
# Nutzung Windows (cmd):  for /f "usebackq tokens=*" %i in ("rechnung.env") do set %i
#
# Diese Datei NICHT ins Git committen, wenn echte Zugangsdaten drin stehen.
# (rechnung.env ist in .gitignore; nur diese .example-Vorlage ist versioniert.)

# ---- IONOS-Postfach (rechnung fetch) ---------------------------------------
RECHNUNG_IMAP_HOST=imap.ionos.de
RECHNUNG_IMAP_PORT=993
RECHNUNG_IMAP_SSL=1
RECHNUNG_IMAP_USER=rechnung@deinefirma.de
RECHNUNG_IMAP_PASSWORD=
# Quellordner im Postfach und (optional) Zielordner nach erfolgreicher Abholung.
RECHNUNG_IMAP_FOLDER=INBOX
RECHNUNG_IMAP_DONE_FOLDER=
# Nur diese Anhang-Endungen holen (kommagetrennt). Bild-Endungen (Scans als
# Foto/TIFF) laufen automatisch durch die Texterkennung (siehe OCR unten).
RECHNUNG_IMAP_EXTENSIONS=.pdf,.xml,.jpg,.jpeg,.png,.tif,.tiff
# Zielordner fuer geholte PDFs (Standard: <data>/inbox).
# RECHNUNG_INBOX=

# ---- JobRouter-Uebergabe (rechnung push) ----------------------------------
# Solange ENABLED nicht 1 ist: reiner Trockenlauf (JSON in data/out/).
RECHNUNG_JOBROUTER_ENABLED=0
RECHNUNG_JOBROUTER_URL=
RECHNUNG_JOBROUTER_TOKEN=
RECHNUNG_JOBROUTER_ENDPOINT=/rest/v2/application/incidents
RECHNUNG_JOBROUTER_TIMEOUT=30
RECHNUNG_JOBROUTER_RETRIES=3
# Nur Rechnungen mit diesen Status uebergeben (kommagetrennt).
RECHNUNG_JOBROUTER_ALLOW_STATUS=auto,review
# Rueckmeldungen (Korrekturen/Ablehnungen) abholen -- Pfad/Format sind ein
# Platzhalter, die genaue API kommt noch vom JobRouter-Admin des Kunden.
RECHNUNG_JOBROUTER_FEEDBACK_ENDPOINT=/rest/v2/application/incidents/feedback
# Prozessname/-version/Schritt/Benutzer/Rolle -- kommen vom JobRouter-Admin
# des Kunden, siehe README-Checkliste "Was wir vom Kunden fuer den Anschluss
# brauchen". Ohne diese Angaben bleibt es beim bisherigen Trockenlauf.
RECHNUNG_JOBROUTER_PROCESS=
RECHNUNG_JOBROUTER_VERSION=
RECHNUNG_JOBROUTER_STEP=
RECHNUNG_JOBROUTER_USER=
RECHNUNG_JOBROUTER_ROLE=
# Feldzuordnung (unser Feldname -> JobRouter-Feldname) als JSON-Datei statt
# fest im Code. Standard: <data>/jobrouter-mapping.json -- Beispiel siehe
# jobrouter-mapping.example.json im Projektwurzelverzeichnis.
RECHNUNG_JOBROUTER_MAPPING=

# ---- KI-Extraktion (semantic.py, SPEC-v1.md §7f/§7j) ----------------------
# Optional, standardmaessig aus. Braucht ein selbst betriebenes Modell: Ollama
# (https://ollama.com) oder einen OpenAI-kompatiblen Server (vLLM/llama.cpp)
# auf dem Firmenserver -- keine Cloud. Modell frei waehlbar/austauschbar ohne
# Code-Aenderung. Jeder Modellwert muss im PDF-Text wiederzufinden sein,
# sonst wird er verworfen.
RECHNUNG_LLM_ENABLED=0
# Backend: "ollama" (Standard) oder "openai" = OpenAI-kompatibler Endpoint auf
# eigener Hardware (vLLM, llama.cpp-Server, ...). Kein Cloud-Dienst vorgesehen.
RECHNUNG_LLM_BACKEND=ollama
# Ollama:              http://127.0.0.1:11434
# OpenAI-kompatibel:   Basis-URL inkl. /v1, z.B. http://llm-server.intern:8000/v1
RECHNUNG_LLM_URL=http://127.0.0.1:11434
RECHNUNG_LLM_MODEL=qwen2.5:3b-instruct
# Nur fuer "openai", falls der interne Server einen Schluessel verlangt.
# RECHNUNG_LLM_API_KEY=
# Stufe 2: ohne Template die komplette Rechnung auslesen (nur wenn ENABLED=1).
RECHNUNG_LLM_FULL=1
# Positionen ebenfalls per Modell auslesen (langsamer).
RECHNUNG_LLM_LINE_ITEMS=0
RECHNUNG_LLM_CTX=4096
RECHNUNG_LLM_TIMEOUT=30
# Deckel: ein LLM-Treffer soll nie allein auf 'auto' hochfahren koennen.
RECHNUNG_LLM_MAX_CONFIDENCE=0.6

# ---- Texterkennung fuer Scans (ocr.py, SPEC-v1.md §7i) ---------------------
# Braucht Tesseract lokal auf dem Rechner (kein Netzwerk), siehe README.
# Ohne Tesseract wird eine Scan-Rechnung sauber zurueckgestellt, nicht abgebrochen.
# Pfad zu tesseract, falls nicht im PATH.
# RECHNUNG_TESSERACT=
# Mittlere Wortkonfidenz (0-100), ab der eine OCR-Rechnung nicht mehr als
# unsicher gilt (darunter: Pruefung "ocr-konfidenz" rot -> Mensch).
RECHNUNG_OCR_MIN_CONF=80
# Wortkonfidenz, unter der ein einzelnes Wort als unsicher gilt -- ein Feld,
# dessen Wert aus so einem Wort stammt, faellt unter die Mindestkonfidenz.
RECHNUNG_OCR_WORD_MIN_CONF=60

# ---- Zeitgrenze pro Rechnung (guard.py, SPEC-v1.md §7m) --------------------
# Gilt fuer die komplette Verarbeitung (inkl. OCR und KI). 0 = keine Grenze.
RECHNUNG_TIMEOUT=120

# ---- Sonstiges ----------------------------------------------------------------
# Datenverzeichnis (Templates/Lieferanten/Archiv/Journal). Standard: ./data
# RECHNUNG_DATA=
# Name im Audit-Trail (Standard: Login-Name).
# RECHNUNG_OPERATOR=
