# Vorlage fuer die optionalen Schnittstellen. Ohne diese Datei bleibt das
# Programm rein lokal/offline (siehe SPEC Abschnitt 5).
#
# Nutzung Linux/macOS:   set -a; . ./rechnung.env; set +a; rechnung fetch
# Nutzung Windows:        start-rechnung.cmd / nachtlauf.cmd neben rechnung.exe lesen
#                         rechnung.env automatisch ein (siehe INSTALL-WINDOWS.md).
#                         Von Hand (cmd): for /f "usebackq eol=# tokens=*" %i in ("rechnung.env") do set "%i"
#
# Format: eine Angabe pro Zeile, NAME=wert, ohne Leerzeichen um das "=" und ohne
# Anfuehrungszeichen; Zeilen mit # am Anfang sind Kommentare.
#
# Diese Datei NICHT ins Git committen, wenn echte Zugangsdaten drin stehen.
# (rechnung.env ist in .gitignore; nur diese .example-Vorlage ist versioniert.)

# ---- IONOS-Postfach (rechnung fetch) ---------------------------------------
RECHNUNG_IMAP_HOST=imap.ionos.de
RECHNUNG_IMAP_PORT=993
RECHNUNG_IMAP_SSL=1
RECHNUNG_IMAP_USER=rechnung@deinefirma.de
RECHNUNG_IMAP_PASSWORD=
# Quellordner im Postfach und (optional) Zielordner nach erfolgreicher Abholung.
RECHNUNG_IMAP_FOLDER=INBOX
RECHNUNG_IMAP_DONE_FOLDER=
# Auch schon GELESENE Mails so viele Tage zurueck abholen (Standard 7).
# Groesser stellen, wenn offene Rechnungen schon von jemandem geoeffnet
# wurden, z.B. 60. Jede Mail wird trotzdem nur einmal geholt.
# RECHNUNG_IMAP_TAGE=7
# Abholordner fuer alle per Excel eingespielten Postfaecher (kommagetrennt).
# Gesetzt -> diese Postfaecher werden NUR GELESEN (nichts markiert, nichts
# verschoben). Fuer Postfaecher, die ABBYY FlexiCapture abarbeitet: dort ist
# INBOX immer leer, die Mails liegen in Done bzw. Error.
# RECHNUNG_POSTFACH_ORDNER=Done,Error
# Nur diese Anhang-Endungen holen (kommagetrennt). Bild-Endungen (Scans als
# Foto/TIFF) laufen automatisch durch die Texterkennung (siehe OCR unten).
RECHNUNG_IMAP_EXTENSIONS=.pdf,.xml,.jpg,.jpeg,.png,.tif,.tiff
# Zielordner fuer geholte PDFs (Standard: <data>/inbox).
# RECHNUNG_INBOX=

# ---- JobRouter-Uebergabe (rechnung push) ----------------------------------
# Solange ENABLED nicht 1 ist: reiner Trockenlauf (JSON in data/out/).
RECHNUNG_JOBROUTER_ENABLED=0
RECHNUNG_JOBROUTER_URL=
RECHNUNG_JOBROUTER_TOKEN=
RECHNUNG_JOBROUTER_ENDPOINT=/rest/v2/application/incidents
RECHNUNG_JOBROUTER_TIMEOUT=30
RECHNUNG_JOBROUTER_RETRIES=3
# Nur Rechnungen mit diesen Status uebergeben (kommagetrennt).
RECHNUNG_JOBROUTER_ALLOW_STATUS=auto,review
# Rueckmeldungen (Korrekturen/Ablehnungen) abholen -- Pfad/Format sind ein
# Platzhalter, die genaue API kommt noch vom JobRouter-Admin des Kunden.
RECHNUNG_JOBROUTER_FEEDBACK_ENDPOINT=/rest/v2/application/incidents/feedback
# Prozessname/-version/Schritt/Benutzer/Rolle -- kommen vom JobRouter-Admin
# des Kunden, siehe README-Checkliste "Was wir vom Kunden fuer den Anschluss
# brauchen". Ohne diese Angaben bleibt es beim bisherigen Trockenlauf.
RECHNUNG_JOBROUTER_PROCESS=
RECHNUNG_JOBROUTER_VERSION=
RECHNUNG_JOBROUTER_STEP=
RECHNUNG_JOBROUTER_USER=
RECHNUNG_JOBROUTER_ROLE=
# Feldzuordnung (unser Feldname -> JobRouter-Feldname) als JSON-Datei statt
# fest im Code. Standard: <data>/jobrouter-mapping.json -- Beispiel siehe
# jobrouter-mapping.example.json im Projektwurzelverzeichnis.
RECHNUNG_JOBROUTER_MAPPING=

# ---- KI-Extraktion (semantic.py, SPEC-v1.md §7f/§7j) ----------------------
# Optional, standardmaessig aus. Braucht ein selbst betriebenes Modell: Ollama
# (https://ollama.com) oder einen OpenAI-kompatiblen Server (vLLM/llama.cpp)
# auf dem Firmenserver -- keine Cloud. Modell frei waehlbar/austauschbar ohne
# Code-Aenderung. Jeder Modellwert muss im PDF-Text wiederzufinden sein,
# sonst wird er verworfen.
RECHNUNG_LLM_ENABLED=0
# Backend: "ollama" (Standard) oder "openai" = OpenAI-kompatibler Endpoint auf
# eigener Hardware (vLLM, llama.cpp-Server, ...). Kein Cloud-Dienst vorgesehen.
RECHNUNG_LLM_BACKEND=ollama
# Ollama:              http://127.0.0.1:11434
# OpenAI-kompatibel:   Basis-URL inkl. /v1, z.B. http://llm-server.intern:8000/v1
RECHNUNG_LLM_URL=http://127.0.0.1:11434
RECHNUNG_LLM_MODEL=qwen2.5:3b-instruct
# Nur fuer "openai", falls der interne Server einen Schluessel verlangt.
# RECHNUNG_LLM_API_KEY=
# Stufe 2: ohne Template die komplette Rechnung auslesen (nur wenn ENABLED=1).
RECHNUNG_LLM_FULL=1
# Positionen ebenfalls per Modell auslesen (langsamer).
RECHNUNG_LLM_LINE_ITEMS=0
# Obergrenze fuer den Modell-Kontext (RAM) -- je Anfrage wird passend zur
# Promptlaenge kleiner gewaehlt (z.B. 1024/2048), SPEC §7x.
RECHNUNG_LLM_CTX=4096
RECHNUNG_LLM_TIMEOUT=30
# Deckel: ein LLM-Treffer soll nie allein auf 'auto' hochfahren koennen.
RECHNUNG_LLM_MAX_CONFIDENCE=0.6

# ---- Texterkennung fuer Scans (ocr.py, SPEC-v1.md §7n) ---------------------
# Braucht Tesseract lokal auf dem Rechner (kein Netzwerk), siehe README.
# Ohne Tesseract wird eine Scan-Rechnung sauber zurueckgestellt, nicht abgebrochen.
# 0 = Texterkennung aus (Scans gehen direkt in den Ordner "Menschliche Bearbeitung").
RECHNUNG_OCR_ENABLED=1
# Pfad zu tesseract, falls nicht im PATH. Unter Windows wird ohne Angabe auch
# C:\Program Files\Tesseract-OCR\tesseract.exe gefunden.
# RECHNUNG_TESSERACT=C:\Program Files\Tesseract-OCR\tesseract.exe
# Mittlere Wortkonfidenz (0-100), ab der eine OCR-Rechnung nicht mehr als
# unsicher gilt (darunter: Pruefung "ocr-konfidenz" rot -> Mensch).
RECHNUNG_OCR_MIN_CONF=80
# Wortkonfidenz, unter der ein einzelnes Wort als unsicher gilt -- ein Feld,
# dessen Wert aus so einem Wort stammt, faellt unter die Mindestkonfidenz.
RECHNUNG_OCR_WORD_MIN_CONF=60
# Parallelitaet fuer mehrseitige Scans (Effizienz-Baustein, SPEC §7x): wie
# viele Seiten gleichzeitig per Tesseract erkannt werden. Standard Kerne-1.
# Auf einem knappen Laptop sparsam einstellen (1-2), sonst bremst OCR die
# restliche Verarbeitung/Oberflaeche aus.
# RECHNUNG_OCR_JOBS=1

# ---- Zeitgrenze pro Rechnung (guard.py, SPEC-v1.md §7m) --------------------
# Gilt fuer die komplette Verarbeitung (inkl. OCR und KI). 0 = keine Grenze.
RECHNUNG_TIMEOUT=120

# ---- Betriebsmodus Testphase -> Autonomie (modus.py, SPEC-v1.md §7v) -------
# Der Modus selbst steht NICHT hier, sondern wird per Befehl umgeschaltet:
#   rechnung modus autonom --operator NAME   /   rechnung modus testphase --operator NAME
# Richtwert fuer die Fortschrittsanzeige (kein automatisches Umschalten):
RECHNUNG_TESTPHASE_IN_FOLGE=50
RECHNUNG_TESTPHASE_LIEFERANTEN=10
# Optional, Standard aus: Prozent sicherer Rechnungen, die im autonomen Modus
# trotzdem zum Menschen gehen (0 = aus).
RECHNUNG_AUTONOM_STICHPROBE=0
# Optional, Standard aus: bei einer JobRouter-Korrektur automatisch zurueck in
# die Testphase (1 = an).
RECHNUNG_AUTONOM_RUECKFALL=0
# IBAN auf der Rechnung weicht von den Stammdaten ab:
#   mensch = zurueckstellen, Ordner "Menschliche Bearbeitung" (Standard)
#   warnen = durchlassen, aber mit deutlichem Warnfeld im JobRouter-Datensatz
RECHNUNG_IBAN_ABWEICHUNG=mensch

# ---- Ordner "Menschliche Bearbeitung" (human.py, SPEC-v1.md §7u) -----------
# Hier landen alle Rechnungen, bei denen das Programm nicht sicher ist (Kopie +
# Begleitdatei mit Gruenden). Standard: <data>/menschlich
# RECHNUNG_MENSCHLICH=

# ---- Sonstiges ----------------------------------------------------------------
# Datenverzeichnis (Templates/Lieferanten/Archiv/Journal). Standard: ./data
# RECHNUNG_DATA=
# Name im Audit-Trail (Standard: Login-Name).
# RECHNUNG_OPERATOR=

# =============================================================================
# LAPTOP-PROFIL (Windows-Firmenlaptop, nur CPU, wenig Arbeitsspeicher)
# Zum Aktivieren die Zeilen unten ohne "# " verwenden -- sie stehen absichtlich
# am Ende, damit sie die Werte weiter oben ueberschreiben.
# =============================================================================
# KI nur einschalten, wenn Ollama mit dem kleinen Modell laeuft
# (build-windows.ps1 -MitOllama prueft das und misst die Antwortzeit):
# RECHNUNG_LLM_ENABLED=1
# RECHNUNG_LLM_MODEL=qwen2.5:1.5b-instruct
# kleiner Kontext = weniger Speicher/schneller; Positionen nicht per KI
# RECHNUNG_LLM_CTX=2048
# RECHNUNG_LLM_LINE_ITEMS=0
# auf CPU braucht eine Antwort deutlich laenger als auf einer Grafikkarte
# RECHNUNG_LLM_TIMEOUT=120
# Modell waehrend eines KI-Stapels geladen halten (spart Ladezeit zwischen
# Rechnungen); nach dem Stapel gibt das Programm es ohnehin frei (SPEC §7x)
# RECHNUNG_LLM_KEEP_ALIVE=30m
# Zeitgrenze je Rechnung bleibt bei 120 s (verbindlich, SPEC §7m/§7x) --
# reicht die Zeit nicht, landet die Rechnung in "Menschliche Bearbeitung",
# statt die Grenze anzuheben. Vorher mit `rechnung messen <ordner>` pruefen,
# welche Stufe die Zeit braucht.
# Texterkennung: nur 1 Kern, damit Oberflaeche/KI fluessig bleiben
# RECHNUNG_OCR_JOBS=1
# Texterkennung bei Bedarf ausschalten, wenn der Laptop zu langsam ist
# RECHNUNG_OCR_ENABLED=0

# ---- Lernbericht an die Entwicklerin (lernbericht.py, 11.10.2026) --------
# Einmal am Tag ab RECHNUNG_BERICHT_STUNDE: was richtig gelesen / korrigiert
# wurde, per Mail ueber dasselbe IONOS-Postfach. Leer = aus. ANONYMISIERT:
# keine Namen/Betraege/IBANs/Nummern/PDFs, nur Fehlerarten + Lieferanten-Kuerzel.
# RECHNUNG_BERICHT_AN=
# RECHNUNG_BERICHT_STUNDE=17
# SMTP (Standard: smtp.ionos.de:587, Zugang wie RECHNUNG_IMAP_USER/_PASSWORD)
# RECHNUNG_SMTP_HOST=smtp.ionos.de
# RECHNUNG_SMTP_PORT=587

# ---- Dummy-Lieferant --------------------------------------------------------
# Ist beim Senden kein (bestaetigter) Lieferant gewaehlt, geht die Rechnung an
# JobRouter mit dem einen Dummy-Lieferanten; die erkannten echten Daten
# (Name, Anschrift, IBAN, USt-IdNr) stehen als "erkannterLieferant" und
# "bemerkung" dabei. Die Kollegen legen den echten Lieferanten dort neu an.
# Beides optional (Standard: "Dummy Lieferant" / "DUMMY").
# RECHNUNG_DUMMY_LIEFERANT_NAME=Dummy Lieferant
# Kontonummer/externe ID, die JobRouter fuer den Dummy bekommt:
# RECHNUNG_DUMMY_LIEFERANT_NR=DUMMY
